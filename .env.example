# AI Infrastructure Control - Environment Variables

# Required: Google Gemini API Key
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Optional: DeepSeek API Key
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional: OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Hermes Agent Configuration (Local)
HERMES_PATH=hermes
HERMES_PROJECT_DIR=.

# Environment
NODE_ENV=development

# Grafana Cloud Monitoring (Faro & OTel)
NEXT_PUBLIC_FARO_URL=your_faro_collector_url_here
NEXT_PUBLIC_FARO_APP_ID=your_faro_app_id_here
OTEL_EXPORTER_OTLP_ENDPOINT=your_otlp_endpoint_here
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic your_base64_encoded_auth_here
